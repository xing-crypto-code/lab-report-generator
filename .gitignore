# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
*.egg

# 虚拟环境
venv/
.venv/
env/

# 环境配置（含敏感 API Key）
.env

# 用户上传和输出（运行时文件夹）
uploads/*
outputs/*
temp/*
!uploads/.gitkeep
!outputs/.gitkeep
!temp/.gitkeep

# 依赖包（本机 pip 装到 libs/ 的第三方库，1.4GB，绝不入库）
libs/

# 模板备份（rebake 自动生成，含旧版模板）
templates/*.bak

# 渲染/调试产物
screenshots/dom.txt

# 外部工具（DSH 沙箱）的体检产物，与本项目无关
acl-recovery/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Gradio
gradio_cached_examples/
flagged/