# ==== Python ====
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
build/
*.egg

# ==== 虚拟环境 ====
.venv/
venv/
env/

# ==== 环境变量与密钥（含 API Key，绝不可入库） ====
.env
.env.*
!.env.example

# ==== 运行产物（用户上传/输出）====
uploads/*
outputs/*
temp/*
!uploads/.gitkeep
!outputs/.gitkeep
!temp/.gitkeep

# ==== 本机依赖 libs（pip --target，1.4GB 不入库）====
libs/

# ==== 模板备份（rebake 自动生成）====
templates/*.bak

# ==== 知识库索引（由 kb/ 内容可随时重建）====
kb/index.sqlite
kb/index.sqlite-journal

# ==== pip 临时构建/缓存/卸载目录（install_deps.py 残留）====
pip-*/
temp/pip-*/

# ==== 渲染/调试产物 ====
screenshots/dom.txt
screenshots/*.png

# ==== 外部工具（如 DSH 沙箱体检产物）====
acl-recovery/

# ==== IDE ====
.vscode/
.idea/
*.swp
*.swo

# ==== OS ====
.DS_Store
Thumbs.db
desktop.ini

# ==== Gradio ====
gradio_cached_examples/
flagged/