# ===== AI API 配置（选一个填即可） =====

# 方案一：DeepSeek（推荐，注册送 500万 tokens）
# 注册地址：https://platform.deepseek.com → API Keys
LLM_API_KEY=sk-your-deepseek-api-key-here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# 方案二：阿里百炼 Qwen（100万 tokens/月免费）
# 注册地址：https://bailian.console.aliyun.com
# LLM_API_KEY=sk-your-qwen-key
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-turbo

# 方案三：硅基流动 SiliconFlow（免费额度，支持 DeepSeek/Qwen 等）
# 注册地址：https://siliconflow.cn
# LLM_API_KEY=sk-your-silicon-key
# LLM_BASE_URL=https://api.siliconflow.cn/v1
# LLM_MODEL=deepseek-ai/DeepSeek-V3